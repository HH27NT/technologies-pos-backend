# =============================================================================
# Plantilla del entorno Docker (docker-compose.yml).
#
#   cp .env.docker.example .env.docker
#
# Luego rellena los valores marcados como GENERAR / CAMBIAR. El archivo resultante
# (.env.docker) está en .gitignore: contiene secretos y NO debe subirse al repositorio.
#
# Arranque:  docker compose --env-file .env.docker up -d --build
# =============================================================================

APP_NAME="Bar POS SaaS"
APP_ENV=local
# GENERAR: `php artisan key:generate --show`. Si se deja vacío, el entrypoint la genera
# en el primer arranque. Ojo: al regenerarse cambia el cifrado de datos existentes.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

# --- Base de datos (apunta al servicio 'db' de la red de compose) ------------
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=bar_pos_saas
DB_USERNAME=postgres
DB_PASSWORD=                # CAMBIAR: contraseña de PostgreSQL
DB_FORWARD_PORT=5433        # puerto del host para conectarte a la BD desde afuera
APP_FORWARD_PORT=8080       # puerto del host donde queda expuesta la API

# --- Autenticación / SPA -----------------------------------------------------
AUTH_PASSWORD_BROKER=users
FRONTEND_URL=http://localhost:5173     # origen de la SPA (front)
SANCTUM_STATEFUL_DOMAINS=localhost:5173
POS_PASSWORD_MIN_LENGTH=8

# --- Autorizaciones (M14.1) --------------------------------------------------
# GENERAR (obligatoria): `php artisan pos:pin-key --show`
#
# Clave del índice HMAC de los PIN de autorización. Va SEPARADA de APP_KEY a propósito:
# `pin_lookup` cubre un espacio de solo 10^6 combinaciones, así que quien tenga esta clave
# y lectura de la base de datos reconstruye todos los PIN en claro con una tabla
# precomputada. Trátala como el secreto más sensible del despliegue.
#
# Debe ser ESTABLE: si cambia, los PIN vigentes dejan de resolver y cada autorizador
# tiene que volver a fijar el suyo en /app/mi-pin. El entrypoint se detiene si falta.
POS_PIN_LOOKUP_KEY=

# --- Super administrador inicial (SuperAdminSeeder) --------------------------
SUPER_ADMIN_EMAIL=super@pos.local
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=                  # CAMBIAR: credencial del primer super_admin

# --- Infraestructura Laravel (driver de BD; no requiere Redis) ---------------
SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_LIFETIME=120

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@pos.local"
MAIL_FROM_NAME="${APP_NAME}"

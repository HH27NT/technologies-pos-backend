APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bar_pos_saas
DB_USERNAME=postgres
DB_PASSWORD=

# Base de datos dedicada a pruebas sobre PostgreSQL (php artisan test -c phpunit.pgsql.xml).
# La conexión de pruebas reutiliza estas variables; usa una BD separada para no pisar datos.
# DB_DATABASE=bar_pos_testing

# Broker de recuperación de contraseña (config/auth.php). 'users' apunta al modelo Usuario.
AUTH_PASSWORD_BROKER=users

# URL del frontend (SPA) usada en el enlace del correo de recuperación (M01).
FRONTEND_URL=http://localhost:5173

# Política de contraseñas (P16): longitud mínima configurable, sin bloqueo por intentos.
POS_PASSWORD_MIN_LENGTH=8

# Clave del índice HMAC de los PIN de autorización (M14.1). OBLIGATORIA: sin ella los PIN
# no resuelven y la app falla en voz alta. Genérala con `php artisan pos:pin-key`.
#
# Es un secreto de la misma categoría que APP_KEY, y va aparte a propósito: `pin_lookup`
# cubre un espacio de solo 10^6 combinaciones, así que quien tenga esta clave y lectura de
# la base de datos reconstruye todos los PIN en claro. Nunca la compartas entre entornos ni
# la subas al repositorio. Rotarla obliga a cada autorizador a fijar su PIN otra vez.
POS_PIN_LOOKUP_KEY=

# Super administrador inicial (SuperAdminSeeder). Cambia estas credenciales.
SUPER_ADMIN_EMAIL=super@pos.local
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
